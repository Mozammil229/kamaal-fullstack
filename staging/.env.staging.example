# Staging environment (4A step 9) — PLACEHOLDERS ONLY, never real values.
# Staging backend + staging DB. NEVER production data, NEVER production secrets.
# Staging keys mirror production key NAMES with DIFFERENT values.
# How to use: copy to staging/.env.staging on the staging host, fill with
# staging-only values, and start with NODE_ENV=staging. The T3 contract suite
# runs against staging from this point on (4E).

NODE_ENV=staging
PORT=3100
MONGODB_URI=mongodb+srv://<staging-db-user>:<staging-db-password>@<staging-cluster-host>/<staging-database>?retryWrites=true&w=majority
JWT_SECRET=<staging-only-random-secret-different-from-production>
ADMIN_USER=admin
ADMIN_PASS=<staging-only-admin-password-different-from-production>
ADMIN_JWT_SECRET=<staging-only-random-secret-different-from-production>
WEB_JWT_SECRET=<staging-only-random-secret-different-from-production>
GEMINI_API_KEY=<staging-only-gemini-key-or-empty>
GEMINI_BACKUP_KEYS=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
BLOB_READ_WRITE_TOKEN=
YOUTUBE_API_KEY=
NEWS_RSS_OVERRIDE=
NEWS_RSS_SEARCH_OVERRIDE=
RSA_PRIVATE_KEY_PEM=
CRON_SECRET=<staging-only-cron-secret>
OPS_INTERNAL_KEY=<staging-only-ops-key>
APIKEY_ENCRYPTION_KEY=<staging-only-key>
MEMORY_ENC_KEY=<staging-only-key>
CORS_ALLOWED_ORIGINS=http://localhost:5173
DISABLE_LEGACY_PASSWORD_FALLBACK=false
