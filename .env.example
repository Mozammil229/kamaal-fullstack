# Kamaal backend — environment template (4A, M-P1-09).
# Copy to .env (never commit .env) or set these in the host/Vercel dashboard.
# PLACEHOLDERS ONLY — no real values in this file.

# Server
PORT=3000
NODE_ENV=production
CORS_ALLOWED_ORIGINS=<comma-separated-allowed-origins-e.g.-https://your-pwa-domain>
# PWA API origin for the enforced CSP connect-src (4D, W2): the extra origin
# the PWA shell may call (its API base when it is NOT the live Vercel origin
# above). Name + purpose only — no value; leave unset unless the PWA API
# lives on a different origin. Must be a full https:// origin, no path.
PWA_API_ORIGIN=<optional-https-origin-for-csp-connect-src>
DISABLE_LEGACY_PASSWORD_FALLBACK=false

# Database (MongoDB Atlas) - use a real connection string in your deployment env, never commit it
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Auth Secrets - generate strong random values for production
JWT_SECRET=<generate-a-long-random-secret>
ADMIN_USER=admin
ADMIN_PASS=<choose-a-strong-admin-password>
ADMIN_JWT_SECRET=<generate-a-long-random-secret>

# PWA cookie auth (Phase 4D) — session lifetimes, defaults when unset.
# Access JWT lifetime in minutes (default 15); refresh-token lifetime in
# days (default 30). Cookie names are fixed in code, not env.
PWA_ACCESS_TTL_MINUTES=15
PWA_REFRESH_TTL_DAYS=30

# Patcher site web users (optional — when unset, the app JWT_SECRET signs
# web tokens; the token still carries type:'web' and is verified ONLY
# against the separate webusers collection, so app/web accounts can never
# mix. Setting a dedicated WEB_JWT_SECRET in Vercel is recommended.)
WEB_JWT_SECRET=<generate-a-long-random-secret>

# Patcher site web users (optional — when unset, the app JWT_SECRET signs
# web tokens; the token still carries type:'web' and is verified ONLY
# against the separate webusers collection, so app/web accounts can never
# mix. Setting a dedicated WEB_JWT_SECRET in Vercel is recommended.)
WEB_JWT_SECRET=<redacted>

# Gemini AI (server-side only - never put these in the Android app)
GEMINI_API_KEY=<redacted>
GEMINI_BACKUP_KEYS=<optional-comma-separated-backup-keys>

# AI provider chain (Gemini -> Groq -> OpenRouter fallback)
GROQ_API_KEY=<optional-groq-api-key>
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=<optional-openrouter-api-key>
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Uploads / media
BLOB_READ_WRITE_TOKEN=<optional-vercel-blob-token>
YOUTUBE_API_KEY=<optional-youtube-data-api-key>

# News (optional overrides for the RSS feeds)
NEWS_RSS_OVERRIDE=<optional-rss-url>
NEWS_RSS_SEARCH_OVERRIDE=<optional-rss-search-url>

# Transport encryption for passwords (optional — RSA private key PEM, \n-escaped)
RSA_PRIVATE_KEY_PEM=<optional-rsa-private-key-pem>

# Internal / ops keys
CRON_SECRET=<optional-cron-secret-for-scheduled-jobs>
OPS_INTERNAL_KEY=<optional-internal-ops-key>
APIKEY_ENCRYPTION_KEY=<optional-set-via-admin-panel>
MEMORY_ENC_KEY=<optional-ai-memory-encryption-key>
