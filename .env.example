# Server
PORT=3000
NODE_ENV=production

# Database (MongoDB Atlas) - use a real connection string in your deployment env, never commit it
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Auth Secrets - generate strong random values for production
JWT_SECRET=<generate-a-strong-random-jwt-secret>
ADMIN_USER=admin
ADMIN_PASS=<choose-a-strong-admin-password>
ADMIN_JWT_SECRET=<generate-a-strong-random-admin-jwt-secret>

# Patcher site web users (optional — when unset, the app JWT_SECRET signs
# web tokens; the token still carries type:'web' and is verified ONLY
# against the separate webusers collection, so app/web accounts can never
# mix. Setting a dedicated WEB_JWT_SECRET in Vercel is recommended.)
WEB_JWT_SECRET=<redacted>

# Gemini AI (server-side only - never put these in the Android app)
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_BACKUP_KEYS=<optional-comma-separated-backup-keys>
